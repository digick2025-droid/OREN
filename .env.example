# Supabase — copier dans .env.local et remplir avec les valeurs du projet
# (Dashboard Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL publique du site — requise pour les emails de confirmation et
# réinitialisation de mot de passe (redirect Supabase Auth).
# En production : https://votre-domaine.com
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé service role — UNIQUEMENT côté serveur, jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fournisseur de paiement :
#   "simulated" — règle tout de suite, pour le dev.
#   "kpay"      - Mobile Money SANS quitter l'application : la demande est
#                 poussée sur le téléphone du client, qui valide avec son code.
#   "monetbil"  - Mobile Money par redirection vers la page Monetbil.
#   "camerpay"  - Mobile Money par redirection vers leur page hébergée.
PAYMENT_PROVIDER=simulated

# ------------------------------------------------------------------
# Monetbil — requis uniquement si PAYMENT_PROVIDER=monetbil
# (Dashboard Monetbil > Services)
# ------------------------------------------------------------------

# Clé unique du service de collecte Monetbil.
MONETBIL_SERVICE_KEY=

# URLs publiques transmises à Monetbil. Le token rend l'URL de notification
# non devinable et le webhook le vérifie avant toute confirmation.
MONETBIL_NOTIFY_TOKEN=
MONETBIL_NOTIFY_URL=https://votre-domaine/api/payments/webhook/monetbil?token=VOTRE_TOKEN_SECRET
MONETBIL_RETURN_URL=https://votre-domaine/paiement/retour

# ------------------------------------------------------------------
# Relances push (notifications de réengagement)
# ------------------------------------------------------------------

# Paire de clés VAPID identifiant l'application auprès des services de push
# des navigateurs. À générer UNE FOIS, puis à ne plus jamais changer : en
# changer invalide d'un coup tous les abonnements déjà enregistrés, et chaque
# utilisateur devrait réaccepter la permission.
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par la spécification Web Push (mailto: ou https:).
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# Protège /api/cron/relances, seule route capable d'envoyer en masse.
# Vercel envoie automatiquement cette valeur en `Authorization: Bearer …`
# aux tâches déclarées dans vercel.json. Sans elle, la route refuse tout.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------------
# K-PAY — requis uniquement si PAYMENT_PROVIDER=kpay
# (Tableau de bord K-PAY > Applications > clés API)
# ------------------------------------------------------------------

# Racine de l'API. Laisser vide pour la valeur par défaut.
# KPAY_API_URL=https://admin.kpay.site

# Clés d'application, envoyées en en-têtes X-API-Key / X-Secret-Key.
# Une clé kpay_test_… bascule en bac à sable : seuls les numéros de test
# sont acceptés (ex. 237653456789 pour le Cameroun).
KPAY_API_KEY=
KPAY_SECRET_KEY=

# Secret HMAC-SHA256 vérifiant la signature des webhooks (en-tête
# X-KPAY-Signature, calculée sur le corps brut).
# Sans lui, /api/payments/webhook/kpay refuse TOUT : aucun mode dégradé.
KPAY_WEBHOOK_SECRET=

# À déclarer comme URL de callback « dépôts » dans le tableau de bord K-PAY :
#   https://votre-domaine/api/payments/webhook/kpay
# Aucune URL de retour n'est nécessaire : le client ne quitte jamais l'appli.

# ------------------------------------------------------------------
# CamerPay — requis uniquement si PAYMENT_PROVIDER=camerpay
# (Tableau de bord CamerPay > Clés API & Webhooks)
# ------------------------------------------------------------------

# Endpoint d'initiation (POST JSON) et token d'accès.
# Confirmé dans la doc « API REST » du tableau de bord CamerPay.
CAMERPAY_API_URL=https://camerpay.biz/api/payment/initiate
CAMERPAY_API_KEY=

# Lecture d'état d'une transaction, utilisée par /api/payments/status pour
# régler un paiement même si le webhook n'arrive jamais (réconciliation).
# Déduite automatiquement de CAMERPAY_API_URL : à ne renseigner que si
# l'endpoint change. `{uuid}` est remplacé par la référence CamerPay.
# CAMERPAY_STATUS_URL=https://camerpay.biz/api/payment/{uuid}/status

# Secret HMAC-SHA256 servant à vérifier la signature des webhooks.
# Sans lui, /api/payments/webhook refuse TOUT : aucun mode dégradé.
CAMERPAY_WEBHOOK_SECRET=

# URL publique du webhook, transmise à CamerPay comme `merchant_callback_url`.
# À déclarer à l'identique dans le tableau de bord CamerPay.
CAMERPAY_CALLBACK_URL=https://votre-domaine/api/payments/webhook

# Page sur laquelle CamerPay renvoie le client après le paiement
# (`merchant_return_url`). Le parcours CamerPay est une REDIRECTION :
# le client quitte l'appli, paie sur camerpay.biz, puis revient ici.
CAMERPAY_RETURN_URL=https://votre-domaine/paiement/retour
